# Copia questo file in .env e riempi i valori.
# .env non va mai committato.

# ─────────────────────────────────────────
#  Server MCP — database
# ─────────────────────────────────────────

# Obbligatori: senza questi tre il server non parte.
DB_NAME=
DB_USER=
DB_PASSWORD=

DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=public
DB_MIN_POOL=2
DB_MAX_POOL=10

# ─────────────────────────────────────────
#  Server MCP — trasporto
# ─────────────────────────────────────────

# stdio            → uso locale, Claude Desktop, client LangChain come sottoprocesso
# sse              → HTTP Server-Sent Events (modalità legacy)
# streamable-http  → standard MCP su HTTP, consigliato per l'uso in rete
TRANSPORT=stdio

# Usati solo con sse o streamable-http
SSE_HOST=0.0.0.0
SSE_PORT=8000

# ─────────────────────────────────────────
#  Server MCP — limiti e sicurezza
# ─────────────────────────────────────────

QUERY_ROW_LIMIT=500
QUERY_TIMEOUT=30
MAX_JOINS=8

# Secondi prima che la cache dello schema si invalidi. 0 = cache infinita.
SCHEMA_CACHE_TTL=300

# Elenchi separati da virgola, senza spazi obbligatori.
# ALLOWED_TABLES: se valorizzato, l'agente vede SOLO queste tabelle.
# DENIED_TABLES: nasconde queste tabelle, ed è ignorato se ALLOWED_TABLES è pieno.
# Esempio: ALLOWED_TABLES=customers,orders,products
ALLOWED_TABLES=
DENIED_TABLES=

LOG_LEVEL=INFO

# ─────────────────────────────────────────
#  Client di esempio (client_setup/agent.py)
# ─────────────────────────────────────────
# Serve solo per provare il server da terminale. Il server non ne ha bisogno.

GROQ_API_KEY=
# llama-3.3-70b-versatile  → qualità SQL migliore
# llama-3.1-8b-instant     → più veloce, qualità leggermente inferiore
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.0

# Come il client si collega al server: stdio, sse o streamable-http
MCP_TRANSPORT=stdio
# Solo per sse/streamable-http
MCP_SSE_URL=http://localhost:8000/sse
# Lasciare vuoto: il client trova da solo server_setup/server.py
MCP_SERVER_PATH=

# true = mostra i tre livelli di validazione (security → sintassi → semantica)
# in terminale, al costo di una chiamata MCP in più
VERBOSE_VALIDATION=false
# false = salta la seconda chiamata all'LLM che riformula la risposta in italiano
NL_ANSWER=true
NL_PREVIEW_LIMIT=20
